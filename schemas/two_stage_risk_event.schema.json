{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "session_id", "turn_id", "timestamp", "query_text", "retrieved_doc_ids", "retrieval_scores", "query_detection", "session_detection", "aggregation", "access_control", "latency_ms", "versions"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "minLength": 1},
    "query_text": {"type": "string", "minLength": 1},
    "retrieved_doc_ids": {"type": "array", "items": {"type": "string"}},
    "retrieval_scores": {"type": "array", "items": {"type": "number"}},
    "query_detection": {"$ref": "#/$defs/detection"},
    "session_detection": {"$ref": "#/$defs/detection"},
    "aggregation": {
      "type": "object",
      "required": ["method", "query_weight", "session_weight", "window_coverage", "total_risk_score"],
      "properties": {
        "method": {"type": "string"},
        "query_weight": {"type": "number"},
        "session_weight": {"type": "number"},
        "window_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "total_risk_score": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "access_control": {
      "type": "object",
      "required": ["mode", "recommended_level", "applied_level", "recommended_actions", "applied_actions", "access_action"],
      "properties": {
        "mode": {"enum": ["disabled", "observe", "enforce"]},
        "recommended_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
        "applied_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
        "recommended_actions": {"type": "array", "items": {"type": "string"}},
        "applied_actions": {"type": "array", "items": {"type": "string"}},
        "access_action": {"enum": ["allow", "restrict_context", "no_context_answer", "summarize_context", "deny_sensitive_answer"]}
      },
      "additionalProperties": false
    },
    "latency_ms": {
      "type": "object",
      "required": ["query_detector", "session_detector", "total_defense"],
      "properties": {
        "query_detector": {"type": "number", "minimum": 0},
        "session_detector": {"type": "number", "minimum": 0},
        "total_defense": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "versions": {"type": "object"}
  },
  "$defs": {
    "detection": {
      "type": "object",
      "required": ["stage", "risk_score", "risk_class", "scoring_method", "suspected_attack_types", "evidence_codes", "status"],
      "properties": {
        "stage": {"enum": ["query", "session"]},
        "risk_score": {"type": "number", "minimum": 0, "maximum": 1},
        "risk_class": {"enum": ["NONE", "WEAK", "STRONG"]},
        "scoring_method": {"type": "string"},
        "suspected_attack_types": {"type": "array", "items": {"type": "string"}},
        "evidence_codes": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
