{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "library", "patterns"],
  "properties": {
    "schema_version": {"const": 1},
    "library": {
      "type": "object",
      "required": ["name", "version", "judge_protocol"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "judge_protocol": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "enabled", "entrypoint", "summary", "required_context", "optional_context"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "entrypoint": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "required_context": {"type": "array", "items": {"type": "string"}},
          "optional_context": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
